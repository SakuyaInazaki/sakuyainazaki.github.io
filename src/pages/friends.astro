---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Friend {
  name: string;
  url: string;
  avatar: string;
  description: string;
}

const friends: Friend[] = [];
---

<BaseLayout title="/friends/" activeBoard="friends" boardName="/friends/">
  <div class="board" id="friendsList">
    {friends.length > 0 ? (
      <div class="friendsGrid">
        {friends.map((friend) => (
          <a class="friendCard" href={friend.url} target="_blank" rel="noopener">
            <img class="friendAvatar" src={friend.avatar} alt={friend.name} loading="lazy" />
            <div class="friendMeta">
              <h4>{friend.name} ↗</h4>
              <p class="friendDesc">{friend.description}</p>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <blockquote class="postMessage">None.</blockquote>
    )}
  </div>

  <hr class="postRule" />

  <!-- 申请友链与本站信息 -->
  <div class="replyContainer" id="exchange">
    <div class="reply" style="width: 100%;">
      <div class="postInfo">
        <span class="subject">Exchange Links</span>
      </div>
      <div class="postMessage">
        <ul>
          <li><strong>Name:</strong> <code>/Sak1m!/</code></li>
          <li><strong>URL:</strong> <code>https://sakuyainazaki.github.io</code></li>
          <li><strong>Icon:</strong> <code>https://sakuyainazaki.github.io/favicon.svg</code></li>
        </ul>
        <p>
          Contact me via GitHub Issue or Email to exchange links.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
