---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatChanDate, formatPostNumber } from '../../utils/format';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const allTags = Array.from(new Set(posts.flatMap(p => p.data.tags)));

const renderedPosts = await Promise.all(
  sortedPosts.map(async (post) => {
    const { Content } = await render(post);
    return { post, Content };
  })
);
---

<BaseLayout title="/blog/" activeBoard="blog" boardName="/blog/">
  {allTags.length > 0 && (
    <div id="tags" style="font-size: 11px; margin: 6px 0; color: var(--text-muted);">
      <strong>Tags:</strong>
      {allTags.map((tag) => (
        <span class="tagBadge">#{tag}</span>
      ))}
    </div>
  )}

  <div id="threads" class="board">
    {renderedPosts.length > 0 ? (
      renderedPosts.map(({ post, Content }, index) => (
        <article class="opPost" id={`p${index + 1}`}>
          {post.data.image && (
            <div class="fileInfo">
              File: <a href={post.data.image} target="_blank">{post.data.image.split('/').pop()}</a>
            </div>
            <label class="thumbBox">
              <input type="checkbox" class="thumbToggle" aria-label="展开/收起图片" />
              <img class="thumbImg" src={post.data.image} alt={post.data.title} loading="lazy" />
            </label>
          )}
          <div class="postInfo">
            <input type="checkbox" disabled aria-hidden="true" />
            <span class="subject">
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </span>
            <span class="name">Sak1m!</span>
            <span class="capcode">## Admin</span>
            <span class="dateTime">{formatChanDate(post.data.pubDate)}</span>
            <span class="postNum">{formatPostNumber(index + 1)}</span>
            <span class="replyLink">[<a href={`/blog/${post.id}`}>Thread</a>]</span>
          </div>

          <blockquote class="postMessage">
            <Content />
          </blockquote>

          {post.data.tags.length > 0 && (
            <div class="omitted">
              {post.data.tags.map((tag) => (
                <span class="tagBadge">#{tag}</span>
              ))}
            </div>
          )}

          {index < renderedPosts.length - 1 && <hr class="postRule" />}
        </article>
      ))
    ) : (
      <blockquote class="postMessage">None.</blockquote>
    )}
  </div>
</BaseLayout>
