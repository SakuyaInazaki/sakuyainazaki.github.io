---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatChanDate, formatPostNumber } from '../../utils/format';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// 提取所有标签
const allTags = Array.from(new Set(posts.flatMap(p => p.data.tags)));
---

<BaseLayout title="博客随笔 (/blog/)" activeBoard="blog" boardName="/blog/ - 文章与随笔">
  <div class="navLinks">
    [<a href="#threads">Catalog</a>] [<a href="#tags">Tags</a>] [<a href="#bottom">Bottom</a>]
  </div>

  <hr class="topRule" />

  <!-- 标签快捷筛选 -->
  {allTags.length > 0 && (
    <div id="tags" style="font-size: 11px; margin: 6px 0; color: var(--text-muted);">
      <strong>分类标签:</strong>
      {allTags.map((tag) => (
        <span class="tagBadge">#{tag}</span>
      ))}
    </div>
  )}

  <div id="threads" class="board">
    {sortedPosts.length > 0 ? (
      sortedPosts.map((post, index) => (
        <article class="opPost" id={`p${index + 1}`}>
          <div class="postInfo">
            <input type="checkbox" disabled aria-hidden="true" />
            <span class="subject">
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </span>
            <span class="name">Sakimi</span>
            <span class="capcode">## Admin</span>
            <span class="dateTime">{formatChanDate(post.data.pubDate)}</span>
            <span class="postNum">{formatPostNumber(index + 1)}</span>
            <span class="replyLink">[<a href={`/blog/${post.id}`}>Reply / Read</a>]</span>
          </div>

          <blockquote class="postMessage">
            <p>{post.data.description}</p>
          </blockquote>

          <div class="omitted">
            {post.data.tags.map((tag) => (
              <span class="tagBadge">#{tag}</span>
            ))}
            <a href={`/blog/${post.id}`} style="margin-left: 6px;">展开阅读全文 »</a>
          </div>

          {index < sortedPosts.length - 1 && <hr class="postRule" />}
        </article>
      ))
    ) : (
      <div class="opPost">
        <blockquote class="postMessage">暂无文章。</blockquote>
      </div>
    )}
  </div>

  <div id="bottom"></div>
</BaseLayout>
