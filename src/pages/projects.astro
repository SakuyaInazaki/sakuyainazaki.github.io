---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Project {
  title: string;
  description: string;
  status: 'Active' | 'WIP' | 'Archive';
  tags: string[];
  githubUrl?: string;
  demoUrl?: string;
}

const projects: Project[] = [];
---

<BaseLayout title="/projects/" activeBoard="projects" boardName="/projects/">
  <div class="board">
    {projects.length > 0 ? (
      <div class="projectsGrid">
        {projects.map((project) => (
          <div class="projectCard">
            <div class="projectHeader">
              <h3 class="projectTitle">
                {project.githubUrl ? (
                  <a href={project.githubUrl} target="_blank" rel="noopener">{project.title}</a>
                ) : (
                  project.title
                )}
              </h3>
              <span style="font-size: 11px; color: var(--subject); font-weight: bold;">[{project.status}]</span>
            </div>
            <p class="projectDesc">{project.description}</p>
            <div style="margin-bottom: 8px;">
              {project.tags.map((t) => (
                <span class="tagBadge">#{t}</span>
              ))}
            </div>
            <div class="projectLinks">
              {project.githubUrl && (
                <a href={project.githubUrl} target="_blank" rel="noopener">[GitHub]</a>
              )}
              {project.demoUrl && (
                <a href={project.demoUrl} target="_blank" rel="noopener">[Demo]</a>
              )}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <blockquote class="postMessage">None.</blockquote>
    )}
  </div>
</BaseLayout>
