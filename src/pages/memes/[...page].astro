---
import type { GetStaticPathsOptions, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatChanDate, formatPostNumber, getMemeThumbnail } from '../../utils/format';
import { getGlobalPostIndex } from '../../utils/posts';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allMemes = await getCollection('memes');
  const sortedMemes = allMemes.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
  return paginate(sortedMemes, { pageSize: 15 });
}

interface Props {
  page: Page<any>;
}

const { page } = Astro.props;
const postIndex = await getGlobalPostIndex();

const renderedMemes = await Promise.all(
  page.data.map(async (meme) => {
    const { Content } = await render(meme);
    const postNum = postIndex.get(`memes:${meme.id}`) || 1;
    return { meme, Content, postNum };
  })
);
---

<BaseLayout title="/memes/" activeBoard="memes" boardName="/memes/">
  <div id="threads" class="board">
    {renderedMemes.length > 0 ? (
      renderedMemes.map(({ meme, Content, postNum }, index) => {
        const thumbSrc = getMemeThumbnail(meme.data.image) || meme.data.image;
        return (
          <article class="opPost" id={`p${postNum}`}>
            <div class="opContainer">
              {meme.data.image && (
                <div class="opMediaCol">
                  <div class="fileInfo">
                    File: <a href={meme.data.image} target="_blank">{meme.data.image.split('/').pop()}</a>
                  </div>
                  <label class="thumbBox">
                    <input type="checkbox" class="thumbToggle" aria-label="展开/收起图片" />
                    <img
                      class="thumbImg"
                      src={thumbSrc}
                      data-full={meme.data.image}
                      alt={meme.data.title || 'meme'}
                      loading={index < 3 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </label>
                </div>
              )}

              <div class="opBodyCol">
                <div class="postInfo">
                  <input type="checkbox" disabled aria-hidden="true" />
                  {meme.data.title && (
                    <span class="subject">
                      <a href={`#p${postNum}`}>{meme.data.title}</a>
                    </span>
                  )}
                  <span class="name">Sak1m!</span>
                  <span class="capcode">## Admin</span>
                  <span class="dateTime">{formatChanDate(meme.data.pubDate)}</span>
                  <span class="postNum"><a href={`#p${postNum}`}>{formatPostNumber(postNum)}</a></span>
                </div>

                <blockquote class="postMessage">
                  <Content />
                </blockquote>
              </div>
            </div>

            {index < renderedMemes.length - 1 && <hr class="postRule" />}
          </article>
        );
      })
    ) : (
      <blockquote class="postMessage">None.</blockquote>
    )}
  </div>

  {page.lastPage > 1 && (
    <div class="pagelist">
      <span>[</span>
      {page.url.prev ? (
        <a href={page.url.prev}>Previous</a>
      ) : (
        <span>Previous</span>
      )}
      <span>]</span>

      <span class="pages">
        {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((pageNum) => {
          const isCurrent = pageNum === page.currentPage;
          const href = pageNum === 1 ? '/memes' : `/memes/${pageNum}`;
          return (
            <span>
              [
              {isCurrent ? (
                <strong>{pageNum}</strong>
              ) : (
                <a href={href}>{pageNum}</a>
              )}
              ]
            </span>
          );
        })}
      </span>

      <span>[</span>
      {page.url.next ? (
        <a href={page.url.next}>Next</a>
      ) : (
        <span>Next</span>
      )}
      <span>]</span>
    </div>
  )}

  <script is:inline>
    // 4chan 原生交互：点击展开大图时按需替换为高清原图
    document.addEventListener('change', (e) => {
      if (e.target && e.target.classList.contains('thumbToggle')) {
        const img = e.target.parentElement?.querySelector('.thumbImg');
        if (img && img.dataset.full && img.src !== img.dataset.full) {
          img.src = img.dataset.full;
        }
      }
    });
  </script>
</BaseLayout>
