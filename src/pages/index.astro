---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatChanDate, formatPostNumber } from '../utils/format';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 5);
---

<BaseLayout title="主页 (/me/)" activeBoard="me" boardName="/Sak1m!/">
  <div class="board">
    <!-- 个人主页置顶 OP 帖 -->
    <article class="opPost" id="about">
      <div class="fileInfo">
        File: <a href="/assets/banner.png" target="_blank">banner.png</a> (654 KB, 1688x948)
      </div>
      <label class="thumbBox">
        <input type="checkbox" class="thumbToggle" aria-label="展开/收起图片" />
        <img class="thumbImg" src="/assets/banner.png" alt="/Sak1m!/" loading="lazy" />
      </label>

      <div class="postInfo">
        <input type="checkbox" disabled aria-hidden="true" />
        <span class="subject">/Sak1m!/</span>
        <span class="name">Sak1m!</span>
        <span class="capcode">## Admin</span>
        <span class="dateTime">{formatChanDate(new Date())}</span>
        <span class="postNum">No.000001</span>
        <span class="replyLink">[<a href="#recent">Recent</a>]</span>
      </div>

      <div class="postMessage">
        <span class="quote">&gt; Welcome to /Sak1m!/.</span>
        <span class="quote">&gt; 个人主页与技术记录。</span>

        <h3>关于 (About)</h3>
        <p>
          欢迎来到我的个人主页。本站参考 4chan 经典风格构建，用于记录技术笔记、思考与日常随笔。
        </p>

        <h3 id="contact">链接 (Links)</h3>
        <ul>
          <li><strong>GitHub：</strong><a href="https://github.com/sakimi" target="_blank" rel="noopener">github.com/sakimi</a></li>
          <li><strong>博客：</strong><a href="/blog">/blog/ - 查看全部文章</a></li>
          <li><strong>项目：</strong><a href="/projects">/projects/ - 项目与实验</a></li>
          <li><strong>友链：</strong><a href="/friends">/friends/ - 同学与友链</a></li>
        </ul>
      </div>
    </article>

    <hr class="postRule" />

    <!-- 最新文章列表 -->
    <section id="recent">
      <div class="navLinks" style="font-weight: bold; margin-bottom: 8px;">
        [ 近期发布 / Recent Posts ]
      </div>

      {sortedPosts.length > 0 ? (
        sortedPosts.map((post, idx) => (
          <div class="replyContainer">
            <div class="reply" style="width: 100%;">
              <div class="postInfo">
                <input type="checkbox" disabled aria-hidden="true" />
                <span class="subject"><a href={`/blog/${post.id}`}>{post.data.title}</a></span>
                <span class="name">Sakimi</span>
                <span class="capcode">## Admin</span>
                <span class="dateTime">{formatChanDate(post.data.pubDate)}</span>
                <span class="postNum">{formatPostNumber(idx + 2)}</span>
                <span class="replyLink">[<a href={`/blog/${post.id}`}>Read</a>]</span>
              </div>
              <div class="postMessage">
                <p>{post.data.description || ''}</p>
                {post.data.tags.length > 0 && (
                  <div style="margin-top: 6px;">
                    {post.data.tags.map((tag) => (
                      <span class="tagBadge">#{tag}</span>
                    ))}
                    <a href={`/blog/${post.id}`} style="font-size: 11px; margin-left: 8px;">阅读全文 »</a>
                  </div>
                )}
              </div>
            </div>
          </div>
        ))
      ) : (
        <div class="opPost">
          <blockquote class="postMessage">暂无文章。</blockquote>
        </div>
      )}
    </section>
  </div>
</BaseLayout>
