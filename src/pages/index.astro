---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatChanDate, formatPostNumber } from '../utils/format';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
---

<BaseLayout title="主页 (/me/)" activeBoard="me" boardName="/sakimi/ - Sakimi's Den">
  <div class="navLinks">
    [<a href="#about">About</a>] [<a href="#now">Now</a>] [<a href="#recent">Recent Posts</a>] [<a href="#contact">Contact</a>]
  </div>

  <hr class="topRule" />

  <div class="board">
    <!-- 个人主页置顶 OP 帖 (About Me) -->
    <article class="opPost" id="about">
      <div class="fileInfo">
        File: <a href="/assets/banner.png" target="_blank">sakimi_profile.png</a> (654 KB, 1688x948)
      </div>
      <label class="thumbBox">
        <input type="checkbox" class="thumbToggle" aria-label="展开/收起图片" />
        <img class="thumbImg" src="/assets/banner.png" alt="Sakimi Banner" loading="lazy" />
      </label>

      <div class="postInfo">
        <input type="checkbox" disabled aria-hidden="true" />
        <span class="subject">Sakimi's Digital Garden & Personal Log</span>
        <span class="name">Sakimi</span>
        <span class="capcode">## Admin</span>
        <span class="dateTime">{formatChanDate(new Date())}</span>
        <span class="postNum">No.000001</span>
        <span class="replyLink">[<a href="#recent">View Recent</a>]</span>
      </div>

      <div class="postMessage">
        <span class="quote">&gt; Welcome to my personal log & digital workshop.</span>
        <span class="quote">&gt; 这里是 Sakimi 的个人主页，参考 4chan 经典风格搭建的极简纯静态小站。</span>

        <h3>关于我 (About)</h3>
        <p>
          你好，我是 <strong>Sakimi</strong>。欢迎来到我的个人看板。<br />
          这个网站是我记录思考、技术折腾心得、分享有趣项目与同学交流的地方。没有算法推送，没有信息过载，只有纯粹的内容与文本。
        </p>

        <h3 id="now">近期状态 (Now)</h3>
        <ul>
          <li><strong>正在学习/折腾：</strong>前端现代框架、静态架构、Linux 云服务、轻量化工具链。</li>
          <li><strong>近期目标：</strong>持续记录个人技术随笔，与同学互相交换友链，完善个人开源作品。</li>
        </ul>

        <h3 id="contact">找到我 (Contact & Links)</h3>
        <ul>
          <li><strong>GitHub：</strong><a href="https://github.com/sakimi" target="_blank" rel="noopener">github.com/sakimi</a></li>
          <li><strong>博客专栏：</strong><a href="/blog">/blog/ - 查看全部文章随笔</a></li>
          <li><strong>开源项目：</strong><a href="/projects">/projects/ - 实验与项目作品</a></li>
          <li><strong>同学友链：</strong><a href="/friends">/friends/ - 交换友链与同学录</a></li>
        </ul>
      </div>
    </article>

    <hr class="postRule" />

    <!-- 最新文章精选预览 -->
    <section id="recent">
      <div class="navLinks" style="font-weight: bold; margin-bottom: 8px;">
        [ 近期发布 / Recent Threads ]
      </div>

      {sortedPosts.length > 0 ? (
        sortedPosts.map((post, idx) => (
          <div class="replyContainer">
            <div class="reply" style="width: 100%;">
              <div class="postInfo">
                <input type="checkbox" disabled aria-hidden="true" />
                <span class="subject"><a href={`/blog/${post.id}`}>{post.data.title}</a></span>
                <span class="name">Sakimi</span>
                <span class="capcode">## Admin</span>
                <span class="dateTime">{formatChanDate(post.data.pubDate)}</span>
                <span class="postNum">{formatPostNumber(idx + 2)}</span>
                <span class="replyLink">[<a href={`/blog/${post.id}`}>Read Thread</a>]</span>
              </div>
              <div class="postMessage">
                <p>{post.data.description || '点击查看正文详情...'}</p>
                <div style="margin-top: 6px;">
                  {post.data.tags.map((tag) => (
                    <span class="tagBadge">#{tag}</span>
                  ))}
                  <a href={`/blog/${post.id}`} style="font-size: 11px; margin-left: 8px;">阅读全文 »</a>
                </div>
              </div>
            </div>
          </div>
        ))
      ) : (
        <div class="replyContainer">
          <div class="reply">
            <div class="postInfo">
              <span class="name">Sakimi</span> <span class="capcode">## Admin</span>
              <span class="dateTime">{formatChanDate(new Date())}</span>
              <span class="postNum">No.000002</span>
            </div>
            <div class="postMessage">
              <p>暂无更多文章，随时准备在 <code>src/content/blog/</code> 中写下第一篇随笔！</p>
            </div>
          </div>
        </div>
      )}
    </section>
  </div>
</BaseLayout>
