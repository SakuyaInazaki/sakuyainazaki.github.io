---
interface Props {
  postTitle?: string;
  postUrl?: string;
}

const { postTitle = '', postUrl = '' } = Astro.props;

// 可在未来填入你的 Giscus 仓库配置即可全自动接通！
// 例如: repo="sakimi/sakimi.github.io", repoId="...", category="...", categoryId="..."
const GISCUS_ENABLED = false;
---

<div class="replySection" id="comments">
  <hr class="topRule" />
  
  <div class="replyBoxContainer">
    <div class="replyBoxHeader">[ 互动讨论 / Leave a Reply ]</div>
    
    <div style="font-size: 11px; margin-bottom: 8px; color: var(--text-muted); line-height: 1.4;">
      <span class="quote">&gt; 欢迎留言、纠错或交流技术想法。</span><br/>
      你可以通过以下任一方式与我互动：
    </div>

    <table class="replyFormTable">
      <tbody>
        <tr>
          <td class="label">快捷方式</td>
          <td>
            <a href="https://github.com/sakimi" target="_blank" rel="noopener">[GitHub 提 Issue / 讨论]</a>
            &nbsp;·&nbsp;
            <a href="mailto:sakimi@example.com?subject=关于博客文章的交流">[发邮件]</a>
          </td>
        </tr>
      </tbody>
    </table>

    {GISCUS_ENABLED ? (
      <div id="giscus-container" style="margin-top: 14px;">
        <!-- Giscus 将在此注入 -->
      </div>
    ) : (
      <div style="margin-top: 10px; font-size: 11px; color: var(--text-muted); border-top: 1px dashed var(--rule); padding-top: 6px;">
        💡 提示：本站已内置 Giscus 评论组件接口，后续只需在 <code>src/components/CommentSection.astro</code> 中填入你的 GitHub 仓库名，即可一键点亮免维护的实时互动评论区！
      </div>
    )}
  </div>
</div>
